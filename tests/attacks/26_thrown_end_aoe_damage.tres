[gd_resource type="Resource" script_class="ArenaCombatActionData" load_steps=14 format=3]

[ext_resource type="Script" path="res://scripts/resources/combat/effects/ArenaCombatApplyData.cs" id="apply"]
[ext_resource type="Script" path="res://scripts/resources/combat/CombatDamageData.cs" id="damage"]
[ext_resource type="Script" path="res://scripts/resources/combat/CombatDamageEntryData.cs" id="damage_entry"]
[ext_resource type="Script" path="res://scripts/resources/combat/effects/ArenaAttackAreaOfEffectData.cs" id="aoe"]
[ext_resource type="Script" path="res://scripts/resources/combat/effects/ArenaAttackThrownProjectileData.cs" id="thrown"]
[ext_resource type="Script" path="res://scripts/resources/combat/actions/ArenaCombatActionData.cs" id="action"]
[ext_resource type="Script" path="res://scripts/resources/combat/actions/ArenaCombatWindupData.cs" id="windup"]

[sub_resource type="Resource" id="entry_2"]
script = ExtResource("damage_entry")
Damage = 10

[sub_resource type="Resource" id="damage_3"]
script = ExtResource("damage")
Entries = Array[ExtResource("damage_entry")]([SubResource("entry_2")])

[sub_resource type="Resource" id="apply_1"]
script = ExtResource("apply")
UseSourceItemDamage = false
Damage = SubResource("damage_3")

[sub_resource type="Resource" id="aoe_4"]
script = ExtResource("aoe")
ScenePath = "res://scenes/components/arena/combat/effects/ArenaAttackAreaOfEffect.tscn"
Apply = SubResource("apply_1")
LifetimeSeconds = 1.2
MaxHits = 100
Radius = 70
TickSeconds = 0.5
UnlimitedHits = true

[sub_resource type="Resource" id="thrown_5"]
script = ExtResource("thrown")
ScenePath = "res://scenes/components/arena/combat/effects/ArenaAttackThrownProjectile.tscn"
OnExpireEffect = SubResource("aoe_4")
LifetimeSeconds = 0.6
Range = 300
TravelSeconds = 0.6
ArcHeight = 80

[sub_resource type="Resource" id="windup_range"]
script = ExtResource("windup")
WindupSeconds = 1.0
ScaleRange = true

[resource]
script = ExtResource("action")
DisplayName = "26 Thrown end AOE damage"
Effect = SubResource("thrown_5")
Windup = SubResource("windup_range")
