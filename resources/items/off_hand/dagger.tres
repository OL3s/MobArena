[ext_resource type="Script" path="res://scripts/resources/combat/actions/ArenaCombatActionData.cs" id="6_action"]
[ext_resource type="Script" path="res://scripts/resources/combat/effects/ArenaMeleeEffectData.cs" id="7_melee_effect"]

[sub_resource type="Resource" id="Resource_dagger_pierce"]
script = ExtResource("4_damage_entry")
Type = 1
Damage = 8

[sub_resource type="Resource" id="Resource_dagger_slash"]
script = ExtResource("4_damage_entry")
Damage = 4

[sub_resource type="Resource" id="Resource_dagger_damage"]
script = ExtResource("3_damage")
Entries = Array[ExtResource("4_damage_entry")]([SubResource("Resource_dagger_pierce"), SubResource("Resource_dagger_slash")])

[sub_resource type="Resource" id="Resource_dagger_melee_effect"]
