ForwardOffset = 6.0

[sub_resource type="Resource" id="Resource_dagger_main_action"]
script = ExtResource("6_action")
DisplayName = "Dagger Jab"
Effect = SubResource("Resource_dagger_melee_effect")
CooldownSeconds = 0.38
WindupSeconds = 0.02
SpawnDistance = 26.0

[resource]
script = ExtResource("1_off")
Damage = SubResource("Resource_dagger_damage")
MainAction = SubResource("Resource_dagger_main_action")
