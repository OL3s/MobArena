[gd_resource type="Resource" script_class="OffHandItemData" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/resources/items/OffHandItemData.cs" id="1_off"]
[ext_resource type="Texture2D" path="res://assets/ui/items/dagger.svg" id="2_icon"]
[ext_resource type="Script" path="res://scripts/resources/combat/CombatDamageData.cs" id="3_damage"]
[ext_resource type="Script" path="res://scripts/resources/combat/CombatDamageEntryData.cs" id="4_damage_entry"]

[sub_resource type="Resource" id="Resource_dagger_pierce"]
script = ExtResource("4_damage_entry")
Type = 1
Damage = 8

[sub_resource type="Resource" id="Resource_dagger_slash"]
script = ExtResource("4_damage_entry")
Type = 0
Damage = 4

[sub_resource type="Resource" id="Resource_dagger_damage"]
script = ExtResource("3_damage")
Entries = Array[ExtResource("4_damage_entry")]([SubResource("Resource_dagger_pierce"), SubResource("Resource_dagger_slash")])

[resource]
script = ExtResource("1_off")
DisplayName = "Dagger"
Description = "A short blade for the off hand."
UiIcon = ExtResource("2_icon")
HeldTexture = ExtResource("2_icon")
Cost = 12
Condition = 1.0
