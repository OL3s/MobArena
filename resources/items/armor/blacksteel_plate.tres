[gd_resource type="Resource" script_class="ArmorItemData" format=3]

[ext_resource type="Script" path="res://scripts/resources/items/ArmorItemData.cs" id="1_armor"]
[ext_resource type="Texture2D" path="res://assets/ui/items/blacksteel_plate.svg" id="2_icon"]
[ext_resource type="Script" path="res://scripts/resources/items/ArmorData.cs" id="3_armor_data"]
[ext_resource type="Script" path="res://scripts/resources/items/ArmorTypeOverrideData.cs" id="4_armor_override"]
[ext_resource type="Script" path="res://scripts/resources/items/ItemRequirementData.cs" id="5_requirement"]
[ext_resource type="Script" path="res://scripts/resources/items/ItemLevelMultiplierData.cs" id="6_multiplier"]

[sub_resource type="Resource" id="Resource_blacksteel_plate_slash"]
script = ExtResource("4_armor_override")
Value = 95

[sub_resource type="Resource" id="Resource_blacksteel_plate_pierce"]
script = ExtResource("4_armor_override")
Type = 1
Value = 80

[sub_resource type="Resource" id="Resource_blacksteel_plate_crush"]
script = ExtResource("4_armor_override")
Type = 2
Value = 45

[sub_resource type="Resource" id="Resource_blacksteel_plate_armor"]
script = ExtResource("3_armor_data")
BaseValue = 75
TypeOverrides = Array[ExtResource("4_armor_override")]([SubResource("Resource_blacksteel_plate_slash"), SubResource("Resource_blacksteel_plate_pierce"), SubResource("Resource_blacksteel_plate_crush")])

[sub_resource type="Resource" id="Resource_blacksteel_plate_requirement"]
script = ExtResource("5_requirement")

[sub_resource type="Resource" id="Resource_blacksteel_plate_multiplier"]
script = ExtResource("6_multiplier")
MultiplierPerLevel = 0.035
StrengthInfluence = 0.0
AgilityInfluence = 0.0
MaxMultiplier = 2.0

[resource]
script = ExtResource("1_armor")
DisplayName = "Blacksteel Plate"
Description = "Heavy blacksteel armor."
UiIcon = ExtResource("2_icon")
TypeTag = 12
StrengthTag = 11
HeldTexture = ExtResource("2_icon")
Cost = 230
MaxDurability = 100
Durability = 100
Requirements = SubResource("Resource_blacksteel_plate_requirement")
LevelMultiplier = SubResource("Resource_blacksteel_plate_multiplier")
ArmorProfile = SubResource("Resource_blacksteel_plate_armor")
ArmorForwardTexture = ExtResource("2_icon")
ArmorBackTexture = ExtResource("2_icon")
