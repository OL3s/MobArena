[gd_resource type="Resource" script_class="ArmorItemData" format=3]

[ext_resource type="Script" path="res://scripts/resources/items/ArmorItemData.cs" id="1_armor"]
[ext_resource type="Texture2D" path="res://assets/ui/items/bronze_mail.svg" id="2_icon"]
[ext_resource type="Script" path="res://scripts/resources/items/ArmorData.cs" id="3_armor_data"]
[ext_resource type="Script" path="res://scripts/resources/items/ArmorTypeOverrideData.cs" id="4_armor_override"]
[ext_resource type="Script" path="res://scripts/resources/items/ItemRequirementData.cs" id="5_requirement"]
[ext_resource type="Script" path="res://scripts/resources/items/ItemLevelMultiplierData.cs" id="6_multiplier"]

[sub_resource type="Resource" id="Resource_bronze_mail_slash"]
script = ExtResource("4_armor_override")
Value = 35

[sub_resource type="Resource" id="Resource_bronze_mail_pierce"]
script = ExtResource("4_armor_override")
Type = 1
Value = 22

[sub_resource type="Resource" id="Resource_bronze_mail_crush"]
script = ExtResource("4_armor_override")
Type = 2
Value = 18

[sub_resource type="Resource" id="Resource_bronze_mail_armor"]
script = ExtResource("3_armor_data")
BaseValue = 28
TypeOverrides = Array[ExtResource("4_armor_override")]([SubResource("Resource_bronze_mail_slash"), SubResource("Resource_bronze_mail_pierce"), SubResource("Resource_bronze_mail_crush")])

[sub_resource type="Resource" id="Resource_bronze_mail_requirement"]
script = ExtResource("5_requirement")

[sub_resource type="Resource" id="Resource_bronze_mail_multiplier"]
script = ExtResource("6_multiplier")
MultiplierPerLevel = 0.025
StrengthInfluence = 0.0
AgilityInfluence = 0.0
MaxMultiplier = 1.65

[resource]
script = ExtResource("1_armor")
DisplayName = "Bronze Mail"
Description = "Dependable bronze armor."
UiIcon = ExtResource("2_icon")
TypeTag = 12
StrengthTag = 10
HeldTexture = ExtResource("2_icon")
Weight = 7
Cost = 1100
MaxDurability = 100
Durability = 100
Requirements = SubResource("Resource_bronze_mail_requirement")
LevelMultiplier = SubResource("Resource_bronze_mail_multiplier")
